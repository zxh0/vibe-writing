<mxfile host="Electron">
    <diagram id="ch01-loop" name="loop">
        <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="harness" value="Harness" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=4;" parent="1" vertex="1">
                    <mxGeometry x="20" y="140" width="600" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="user" value="用户的任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFCC;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="model" value="模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="300" y="20" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="msgs" value="消息列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFFFF;" parent="1" vertex="1">
                    <mxGeometry x="40" y="170" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="check" value="回复里有&lt;br&gt;&amp;lt;bash&amp;gt;吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFCC;" parent="1" vertex="1">
                    <mxGeometry x="290" y="160" width="140" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="bash" value="执行命令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCCC;" parent="1" vertex="1">
                    <mxGeometry x="300" y="300" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="done" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E6E6E6;" parent="1" vertex="1">
                    <mxGeometry x="500" y="175" width="90" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="任务" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" parent="1" source="user" target="msgs" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="整段对话" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="msgs" target="model" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="230" y="185"/>
                            <mxPoint x="230" y="50"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e3" value="回复" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" parent="1" source="model" target="check" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="没有" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" parent="1" source="check" target="done" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="有" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;" parent="1" source="check" target="bash" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="回复和输出&lt;br&gt;追加到末尾" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="bash" target="msgs" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
